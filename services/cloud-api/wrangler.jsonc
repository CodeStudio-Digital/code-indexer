{
  // CodeStudio Cloud API — accounts / auth / billing / feedback / sharing.
  // Resources live on the CodeStudio Cloudflare account
  // (0748c7a37faefcdbd0b2ab71580791cd), region ENAM. Bindings are added
  // INCREMENTALLY per plan phase so `wrangler dev` stays green at each step:
  //   Phase 0 (now): D1 + KV + R2 + /v1/health
  //   Phase 1: + Durable Object (LoginThrottleDO), secrets (ACCESS_SIGNING_KEY)
  //   Phase 2: + send_email binding EMAIL (+ allowed_sender_addresses)
  //   Phase 3: + Stripe secrets;  Phase 6: + ratelimit bindings
  "name": "codestudio-cloud-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "0748c7a37faefcdbd0b2ab71580791cd",
  // Sample 10% of requests for logs in prod (cost). Security alerting does NOT
  // depend on this — login_fail/token_reuse/account_deleted are written 100% to
  // the durable, append-only `audit_log` table in D1.
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codestudio-cloud",
      "database_id": "5b0b7069-d453-4e07-ab2c-906835edf6c4",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "5a33b2b91d004648b0a72a70d69bf1a4" }
  ],
  "r2_buckets": [
    { "binding": "ASSETS", "bucket_name": "codestudio-cloud-assets" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LOGIN_THROTTLE", "class_name": "LoginThrottleDO" },
      { "name": "RATE_LIMIT", "class_name": "RateLimitDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LoginThrottleDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimitDO"] }
  ],
  // Email Sending — domain `public.codestudio.digital` onboarded + DNS verified
  // (Cloudflare dash → Email → Email Sending). `allowed_sender_addresses` restricts
  // which From the Worker may use (must match EMAIL_FROM). For local `wrangler dev`
  // email tests, add `"remote": true` to proxy sends to the real service.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["no-reply@public.codestudio.digital"] }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // Until the custom domains are mapped, point user-facing base URLs at the LIVE
    // surfaces: APP_BASE_URL is used for verify-email/reset-password email links
    // (portal pages); SHARE_BASE_URL backs the hosted docs (/d) + shares (/s) which
    // are served by THIS worker. Switch to app./share.codestudio.dev once mapped.
    "APP_BASE_URL": "https://codestudio-account-portal.pages.dev",
    "SHARE_BASE_URL": "https://codestudio-cloud-api.maiconspo6792.workers.dev",
    "EMAIL_FROM": "no-reply@public.codestudio.digital",
    // Explicit CORS allowlist (auditable). The desktop app is not a browser origin;
    // these are the future web viewer / dashboard origins.
    "ALLOWED_ORIGINS": "https://share.codestudio.dev,https://app.codestudio.dev,https://account.codestudio.dev,https://codestudio-account-portal.pages.dev",
    // Browser OAuth (P7-B/C) — public config. The per-provider client id/secret +
    // OAUTH_STATE_SECRET are SECRETS (set via `wrangler secret put`), not here.
    // OAUTH_PUBLIC_BASE_URL is where providers redirect back (this Worker); the
    // registered callback is <OAUTH_PUBLIC_BASE_URL>/v1/auth/oauth/<provider>/callback.
    "OAUTH_PUBLIC_BASE_URL": "https://codestudio-cloud-api.maiconspo6792.workers.dev",
    // Points at the LIVE Pages deployment until account.codestudio.dev is mapped to
    // the Pages project. Switch back to the custom domain once DNS is set up.
    "PORTAL_BASE_URL": "https://codestudio-account-portal.pages.dev"
  }
}
