{
	"name": "mcp-indexer-worker",
	"account_id": "0748c7a37faefcdbd0b2ab71580791cd",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-23",
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "code-index",
			"remote": true
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}