{
  "name": "mcp-code-indexer",
  "version": "3.14.0",
  "description": "Codebase indexing platform powered by LLMs with hybrid search, MCP Server, and web dashboard",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-code-indexer": "./dist/apps/cli/index.js",
    "mcp-code-indexer-server": "./dist/apps/mcp-server/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-prompts.mjs",
    "build:dashboard": "vite build src/apps/dashboard",
    "build:all": "tsc && node scripts/copy-prompts.mjs && vite build src/apps/dashboard",
    "dev:server": "tsx watch src/apps/http-api/server.ts",
    "dev:dashboard": "vite dev src/apps/dashboard",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:dashboard\"",
    "start": "node --max-old-space-size=8192 dist/apps/cli/index.js",
    "start:server": "node --max-old-space-size=8192 dist/apps/mcp-server/index.js",
    "start:api": "node --max-old-space-size=8192 dist/apps/http-api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/genai": "^1.48.0",
    "@google/generative-ai": "^0.21.0",
    "@hono/node-server": "^1.19.12",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^13.1.0",
    "dotenv": "^17.4.0",
    "glob": "^11.0.1",
    "hono": "^4.7.5",
    "ignore": "^7.0.4",
    "lucide-react": "^1.7.0",
    "minimatch": "^10.0.1",
    "openai": "^4.85.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.4",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "mcp",
    "code-indexer",
    "llm",
    "codebase",
    "search",
    "embeddings"
  ],
  "license": "MIT"
}
