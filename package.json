{
  "name": "mcp-code-indexer",
  "version": "3.15.1",
  "packageManager": "pnpm@10.22.0",
  "description": "Codebase indexing platform powered by LLMs with hybrid search, MCP Server, and web dashboard",
  "type": "module",
  "main": "dist/apps/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "mcp-code-indexer": "./dist/apps/cli/index.js",
    "mcp-code-indexer-server": "./dist/apps/mcp-server/index.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias && node scripts/copy-prompts.mjs",
    "build:dashboard": "vite build apps/dashboard",
    "build:portal": "vite build apps/account-portal",
    "dev:portal": "vite dev apps/account-portal",
    "build:all": "tsc && tsc-alias && node scripts/copy-prompts.mjs && vite build apps/dashboard",
    "build:bundled-plugins": "node scripts/build-bundled-plugins.mjs",
    "smoke:js-debug": "tsx scripts/smoke-js-debug-adapter.ts",
    "dev:server": "tsx watch apps/http-api/server.ts",
    "dev:dashboard": "vite dev apps/dashboard",
    "better-sqlite3": "npm rebuild better-sqlite3",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:dashboard\"",
    "electron:dev": "concurrently --kill-others \"npm run dev:dashboard\" \"tsx apps/electron/dev.ts\"",
    "profile": "electron --js-flags=\"--prof\" .",
    "electron:build": "node scripts/build-electron.mjs",
    "release": "node scripts/release.mjs",
    "electron:rebuild": "electron-rebuild -f -o better-sqlite3",
    "node:rebuild": "pnpm rebuild better-sqlite3 node-pty",
    "start": "node --max-old-space-size=8192 dist/apps/cli/index.js",
    "start:server": "node --max-old-space-size=8192 dist/apps/mcp-server/index.js",
    "start:api": "node --max-old-space-size=8192 dist/apps/http-api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test --config apps/dashboard/playwright.config.ts",
    "test:visual:update": "playwright test --config apps/dashboard/playwright.config.ts --update-snapshots",
    "check:loc": "tsx scripts/check-loc-cap.ts",
    "check:agent-loc": "tsx scripts/check-rust-agent-loc.ts",
    "check:cycles": "tsx scripts/check-circular-imports.ts",
    "check:agent-boundary": "tsx scripts/check-rust-agent-legacy-boundary.ts",
    "check:agent-crates": "tsx scripts/check-rust-agent-crate-boundaries.ts",
    "check:deadcode": "knip",
    "check:arch": "npm run check:loc && npm run check:cycles && npm run check:agent-boundary && npm run check:agent-crates && npm run check:deadcode",
    "agent:rust:fmt": "cargo fmt --manifest-path native/agent-runtime/Cargo.toml --all -- --check",
    "agent:rust:check": "cargo check --manifest-path native/agent-runtime/Cargo.toml --workspace --all-targets --locked",
    "agent:rust:clippy": "cargo clippy --manifest-path native/agent-runtime/Cargo.toml --workspace --all-targets --all-features --locked -- -D warnings",
    "agent:rust:test": "cargo test --manifest-path native/agent-runtime/Cargo.toml --workspace --all-targets --locked",
    "agent:rust:package": "node scripts/package-rust-agent-runtime.mjs",
    "agent:rust:package:verify": "tsx scripts/verify-rust-agent-runtime-package.ts",
    "agent:rust:package:smoke": "tsx scripts/smoke-rust-agent-runtime-package.ts",
    "agent:rust:addon:electron-smoke": "node scripts/smoke-rust-agent-host-bridge-electron.mjs",
    "agent:rust:perf:spawn": "node scripts/benchmark-rust-agent-startup.mjs --warmup 10 --samples 100 --threshold-ms 250",
    "agent:rust:installed-smoke": "tsx scripts/rust-agent-installed-smoke.ts",
    "agent:host:test": "vitest run packages/agent-runtime-contracts packages/agent-runtime-host",
    "audit:env": "tsx scripts/audit-env-vars.ts",
    "audit:env:check": "tsx scripts/audit-env-vars.ts --check",
    "market:smoke": "tsx scripts/market-smoke.ts",
    "migrate:data-dir": "tsx scripts/migrate-data-dir.ts",
    "sessions:fs-migrate": "node scripts/run-sessions-fs-migrate.mjs",
    "drawio:fetch": "node scripts/fetch-drawio.mjs",
    "icons:fetch": "node scripts/fetch-material-icons.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "pnpm rebuild better-sqlite3",
    "eval": "tsx src/benchmarks/search-quality.ts --project CodeStudio/MCP-CodeBase",
    "eval:strict": "tsx src/benchmarks/search-quality.ts --project CodeStudio/MCP-CodeBase --modes fts,hybrid --min-recall 0.7 --gate-mode hybrid",
    "eval:docs": "tsx scripts/docs-rag-eval.ts --file packages/services/src/services/docs/__tests__/eval/gold-set.example.jsonl",
    "eval:agent-engineering": "tsx scripts/eval-agent-engineering.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-bedrock": "^3.1029.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1087.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1029.0",
    "@bufbuild/protobuf": "2.13.0",
    "@google/genai": "^1.48.0",
    "@google/generative-ai": "^0.21.0",
    "@hono/node-server": "^1.19.12",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@scalar/api-reference-react": "^0.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-virtual": "^3.14.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.2",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "chokidar": "^4.0.3",
    "chroma-js": "3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^13.1.0",
    "dotenv": "^17.4.0",
    "gifenc": "^1.0.3",
    "glob": "^11.0.1",
    "google-auth-library": "^10.6.2",
    "hono": "^4.7.5",
    "https-proxy-agent": "^7.0.1",
    "i18next": "^26.0.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "ignore": "^7.0.4",
    "image-q": "^4.0.0",
    "jpeg-js": "^0.4.4",
    "jsonpath-plus": "^10.4.0",
    "lucide-react": "^1.7.0",
    "minimatch": "^10.0.1",
    "monaco-editor": "^0.52.2",
    "mssql": "^12.6.0",
    "mysql2": "^3.11.5",
    "node-fetch": "^3.3.2",
    "officeparser": "^7.2.1",
    "node-pty": "^1.1.0",
    "openai": "^4.85.4",
    "pg": "^8.13.1",
    "playwright-core": "1.61.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.3",
    "react-diff-view": "^3.3.3",
    "react-i18next": "^17.0.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.10.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "sqlite-vec": "^0.1.9",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^3.5.0",
    "tm-grammars": "^1.31.15",
    "tree-sitter-wasms": "^0.1.13",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.2",
    "undici": "^7.25.0",
    "unpdf": "^1.6.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "web-tree-sitter": "^0.24.7",
    "ws": "^8.18.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@playwright/test": "1.61.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/ssh2": "^1.15.5",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "knip": "^5.64.4",
    "rcedit": "^5.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.14",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "mcp",
    "code-indexer",
    "llm",
    "codebase",
    "search",
    "embeddings"
  ],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "electron-builder-squirrel-windows": "26.15.3"
    }
  }
}
