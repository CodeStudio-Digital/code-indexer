# ============================================================================
# MCP Code Indexer — Environment Variables Reference
# ============================================================================
# Copy this file to .env and fill in the values you need.
# All variables are optional unless noted. Defaults are shown in comments.
# Loaded via dotenv/config at startup.
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
# LLM Provider API Keys
# ────────────────────────────────────────────────────────────────────────────
# Configure at least ONE key. Auto-detection follows provider registry order.
# Set MCP_INDEX_PROVIDER below to force a specific provider for indexing.

# Anthropic (Claude) — https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# OpenRouter — https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=sk-or-...
# Optional app attribution headers:
# OPENROUTER_HTTP_REFERER=http://localhost:7333
# OPENROUTER_APP_TITLE=MCP Code Indexer

# DeepSeek — https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-...

# Google Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=AI...

# ZAI (GLM) — https://open.bigmodel.cn/
# Used for both indexer and coder agent. Default models: glm-5.1, glm-4.6
# ZAI_API_KEY=...


# ────────────────────────────────────────────────────────────────────────────
# Web Search (Coder Agent)
# ────────────────────────────────────────────────────────────────────────────

# Brave Search API key — https://brave.com/search/api/
# Free tier: 2000 queries/month. When set, web_search uses Brave.
# When absent, falls back to DuckDuckGo HTML scraping.
# BRAVE_API_KEY=BSA...


# ────────────────────────────────────────────────────────────────────────────
# AWS Bedrock (optional LLM provider)
# ────────────────────────────────────────────────────────────────────────────
# Used by both indexer and coder Bedrock providers.
# Requires AWS credentials configured via standard AWS SDK methods
# (env vars, ~/.aws/credentials, IAM role, etc.)

# AWS region for Bedrock API calls. Default: us-east-1
# AWS_REGION=us-east-1

# Fallback region if AWS_REGION is not set. Default: us-east-1
# AWS_DEFAULT_REGION=us-east-1


# ────────────────────────────────────────────────────────────────────────────
# Indexer Configuration (MCP_INDEX_*)
# ────────────────────────────────────────────────────────────────────────────

# Path to the SQLite database.
# Default: ~/.mcp-code-indexer/index.db
# MCP_INDEX_DB=~/.mcp-code-indexer/index.db

# Canonical data directory — holds index.db plus all runtime state:
# virtual-projects/, sandboxes/,
# qa-reports/, exports/, company-drives/, plugins/, etc.
# Default: ~/.mcp-code-indexer. Set this to relocate EVERYTHING at once.
# (Legacy builds wrote some of these under <repo>/data — run
#  `pnpm migrate:data-dir` once to move an existing data/ tree here.)
# MCP_DATA_DIR=~/.mcp-code-indexer
#
# Per-subsystem overrides (absolute paths) — relocate ONE subsystem,
# taking precedence over MCP_DATA_DIR:
#   MCP_SANDBOX_WORKDIR_HOST_DIR  → base for virtual-projects/ (sandbox workdirs)
#   MCP_SANDBOX_ARCHIVE_DIR       → sandbox workdir archives (.tar)
# MCP_SANDBOX_WORKDIR_HOST_DIR=
# MCP_SANDBOX_ARCHIVE_DIR=

# LLM provider for indexing. Auto-detected from API keys if not set.
# Options: anthropic, openai, openrouter, deepseek, zai, gemini, bedrock
# MCP_INDEX_PROVIDER=zai

# Specific model for indexing. Uses provider default if not set.
# Examples: claude-sonnet-4-6, gpt-4o-mini, ~openai/gpt-latest, glm-5.1, deepseek-chat, gemini-2.5-flash
# MCP_INDEX_MODEL=glm-5.1

# Dashboard/API HTTP port. Default: 7333 (uncommon range to avoid colliding
# with the usual 3333 other tools grab). The Vite dev proxy follows this value.
# MCP_INDEX_PORT=7333

# Vite dev server port (dashboard SPA). Default: 7317.
# MCP_DASHBOARD_PORT=7317

# Streamable HTTP MCP endpoint for Claude Code, Codex, Cursor and other
# MCP clients. The endpoint is loopback-only even when the dashboard is
# bound to a wider interface.
# MCP_HTTP_ENABLED=true
# MCP_HTTP_PATH=/mcp
# MCP_HTTP_STATEFUL=false
# MCP_HTTP_CORS_ORIGINS=http://127.0.0.1:7317,http://localhost:7317

# Require scoped bearer/OAuth credentials on the HTTP MCP endpoint.
# Keep enabled outside isolated local development.
# MCP_AUTH_ENABLED=true
# MCP_AUTH_RATE_LIMIT=120

# Number of concurrent indexing tasks. Default: 5
# MCP_INDEX_CONCURRENCY=5

# Cost budget limit in dollars. Indexing stops when exceeded.
# No default (unlimited). Example: 10.00
# MCP_INDEX_BUDGET=


# ────────────────────────────────────────────────────────────────────────────
# Cloudflare Embeddings (optional, for vector search)
# ────────────────────────────────────────────────────────────────────────────

# Enable/disable vector embeddings. Values: "true" or "false". Default: false
# Requires WORKER_URL and WORKER_TOKEN to be set.
# MCP_INDEX_EMBEDDINGS=false

# Cloudflare Workers URL for the embeddings endpoint.
# Deploy the worker from the /worker directory first.
# MCP_INDEX_WORKER_URL=https://mcp-indexer-worker.your-account.workers.dev

# Authentication token for the embeddings worker.
# Must match the token configured in the Worker's environment.
# MCP_INDEX_WORKER_TOKEN=your-secret-token

# Vectors are isolated per namespace (code → per project, docs → per
# collection) so one project/collection never pollutes another's search.
# On Cloudflare Vectorize the namespace is a metadata filter — create the
# metadata index ONCE so the filter is honored (otherwise it's ignored):
#   wrangler vectorize create-metadata-index <index> --propertyName namespace --type string
# Qdrant/Pinecone/sqlite-vec use their native primitives and need no setup.


# ────────────────────────────────────────────────────────────────────────────
# Reranker (cross-encoder re-scoring after the FTS+vector RRF merge)
# ────────────────────────────────────────────────────────────────────────────
# A reranker scores (query, passage) pairs jointly and is what makes
# `mode='hybrid'` beat plain FTS — without one, hybrid is measurably WORSE on
# code queries. The seed picks a default automatically:
#   1. COHERE_API_KEY set        → Cohere Rerank (paid API)
#   2. MCP_RERANK_WORKER_URL set → Cloudflare bge-reranker worker
#   3. neither (desktop default) → LOCAL ONNX cross-encoder (offline, free)
# You can also switch in Admin → Storage → Reranker. The local model downloads
# lazily on first use into MCP_MODEL_CACHE_DIR below.

# Cache dir for local ONNX models (reranker + local embeddings). OPTIONAL —
# defaults to ~/.mcp/models, created automatically. Only set this to override
# the location (Electron points it at userData/models so models survive app
# updates; in dev you rarely need it).
# MCP_MODEL_CACHE_DIR=/abs/path/to/models

# Optional: override the local reranker model (default Xenova/bge-reranker-base).
# A lighter alternative: mixedbread-ai/mxbai-rerank-xsmall-v1
# (set per-config in Admin → Storage → Reranker, not via env).

# Cohere Rerank (optional, paid) — auto-seeded as default when present.
# COHERE_API_KEY=
# COHERE_RERANK_MODEL=rerank-v3.5

# Cloudflare reranker worker (optional) — auto-seeded as default when present.
# Deliberately NOT shared with MCP_INDEX_WORKER_URL so enabling embeddings
# doesn't silently add per-query rerank latency/cost.
# MCP_RERANK_WORKER_URL=
# MCP_RERANK_WORKER_TOKEN=

# Force the doc-RAG reranker mode: 1 = always cross-encoder, 0 = always the
# LLM-as-judge fallback. Unset = use the cross-encoder whenever one is
# configured (i.e. the local default), else fall back to the LLM judge.
# DOCS_RERANK_CROSS_ENCODER=


# ────────────────────────────────────────────────────────────────────────────
# Indexer Embeddings Tuning
# ────────────────────────────────────────────────────────────────────────────

# Minimum body lines for a symbol to get its own vector embedding.
# Tiny helpers below this threshold are skipped. Default: 8
# MCP_INDEX_BODY_MIN_LINES=8

# Maximum character count for body content sent to embeddings. Default: 2500
# MCP_INDEX_BODY_MAX_CHARS=2500


# ────────────────────────────────────────────────────────────────────────────
# Coder Agent — Token Economy & Push-Time Truncation
# ────────────────────────────────────────────────────────────────────────────
# These control how aggressively tool outputs are truncated to preserve
# prompt cache stability and keep costs down.

# Max chars per tool_result block before truncation. Default: 8000
# Truncated results get a deterministic marker so cache prefixes stay stable.
# CODER_PUSH_TIME_CAP=8000

# Tighter per-block cap for subagent tool results. Default: 4000
# Subagents produce many small results; a tighter cap keeps them under budget.
# CODER_SUBAGENT_PUSH_TIME_CAP=4000

# Per-turn safety budget (chars). Emits a warning when exceeded. Default: 30000
# CODER_TURN_BUDGET_CHARS=30000


# ────────────────────────────────────────────────────────────────────────────
# spawn_agent — subagent resource guards
# ────────────────────────────────────────────────────────────────────────────
# IMPORTANT: *_MAX_TOOLS caps the number of tool *CALLS* (invocations) a
# subagent may make — NOT the number of tools it can see. (Misleading name kept
# for back-compat.) When a subagent reaches its budget it stops with
# reason=tool_budget: a benign partial result (salvaged summary), not an error;
# hitting the wall-clock cap is the analogous reason=time_budget.
#
# UNSET = automatic hard caps (the default): explore/review derive 2x the
# research-depth soft target (quick 32 calls/6min, standard 80/14, deep 160/24,
# exhaustive 320/50); implement/full 150 calls/30min; verify 80/15min. An 80%
# warning nudge asks the subagent to synthesize before the cutoff. Explicit
# 0 = unlimited. The per-profile override in the admin Providers panel wins
# over these env values. Same layering for execute_tasks via
# CODER_TASK_{INVESTIGATE,IMPLEMENT,VERIFY}_{MAX_TOOLS,TIMEOUT_MS}.
# CODER_SPAWN_EXPLORE_MAX_TOOLS=160
# CODER_SPAWN_EXPLORE_TIMEOUT_MS=1440000  # 24min hard wall-clock
# CODER_SPAWN_EXPLORE_STALL_MS=90000      # abort if 90s without semantic progress
# CODER_SPAWN_IMPLEMENT_MAX_TOOLS=150
# CODER_SPAWN_FULL_MAX_TOOLS=150


# ────────────────────────────────────────────────────────────────────────────
# Coder Agent — Auto-Compaction
# ────────────────────────────────────────────────────────────────────────────
# When history grows too large, older tool_result blocks are replaced with
# deterministic markers to free space without breaking cache prefixes.

# Min total chars before auto-compaction triggers. Default: 20000
# Below this, compaction is a no-op.
# CODER_PRUNE_MINIMUM=20000

# Chars of recent history protected from compaction. Default: 40000
# Only tool_results older than this window are pruned.
# CODER_PRUNE_PROTECT=40000


# ────────────────────────────────────────────────────────────────────────────
# Coder Agent — MCP Bridge Tuning
# ────────────────────────────────────────────────────────────────────────────
# Controls how the coder agent interacts with MCP indexer tools.

# Last-resort guard for broken/hostile MCP payloads. Normal large outputs flow
# to the central reducer/output store intact. Defaults: 8M guard, 32M spill.
# CODER_MCP_PATHOLOGICAL_OUTPUT_CHARS=8000000
# CODER_MCP_PATHOLOGICAL_STORE_MAX_CHARS=32000000

# Max explicit lines accepted by mcp__read_file before bridge clamping.
# Default: 800. Ordinary omitted max_lines remains server-controlled.
# CODER_READ_FILE_HARD_MAX=800

# Comma-separated list of MCP tool names to hide from the agent.
# Example: add_snapshot,index_project,delete_project
# CODER_DISABLED_MCP_TOOLS=

# When "1", truncates tool descriptions longer than 150 chars to the first
# sentence. Reduces prompt size for models with tight context. Default: 0
# CODER_TERSE_TOOLS=0


# ────────────────────────────────────────────────────────────────────────────
# Coder Agent — Safety & Loop Prevention
# ────────────────────────────────────────────────────────────────────────────

# Number of identical consecutive tool-call turns before aborting.
# Prevents cost blowups from stuck loops. Set 0 to disable. Default: 3
# CODER_DOOM_LOOP_THRESHOLD=3


# ────────────────────────────────────────────────────────────────────────────
# Coder Agent — Tool Output Store
# ────────────────────────────────────────────────────────────────────────────

# Days to keep side-file tool outputs before garbage collection. Default: 7
# Full outputs are persisted when truncated, retrievable via get_tool_output.
# CODER_TOOL_OUTPUT_TTL_DAYS=7


# ────────────────────────────────────────────────────────────────────────────
# Coder Agent — Profile & Tool Tiers
# ────────────────────────────────────────────────────────────────────────────

# Tool tier profile. Controls which tools are available on the first turn.
# Options:
#   bootstrap — ~13 essential tools (fresh sessions default)
#   navigate  — adds edit/git read/local nav tools
#   full      — all tools including admin (resumed sessions default)
#   auto      — inferred from the user message content
# Default: "bootstrap" for new sessions, "full" for resumed.
# CODER_PROFILE=

# Set "1" to disable the subagent tool (delegate_task). Default: 0 (enabled)
# CODER_DISABLE_SUBAGENTS=0

# Set "1" to log active tool count and tiers at session start. Default: 0
# CODER_LOG_TOOLS_COUNT=0

# JSON override for per-model max-tools caps.
# Built-in: claude-opus-4-6=200, glm-5.1=50, gpt-4o=128, deepseek-chat=40, etc.
# Example: {"my-custom-model": {"maxTools": 30}}
# CODER_MODEL_CAPS=


# ────────────────────────────────────────────────────────────────────────────
# Coder Agent — History Summarization (experimental)
# ────────────────────────────────────────────────────────────────────────────

# Set "1" to enable LLM-driven history summarization during compaction.
# Produces a structured summary (~500 tokens) instead of just [compacted] markers.
# Opt-in: failures fall back to deterministic compaction. Default: 0
# CODER_SUMMARIZER_ENABLE=0


# ────────────────────────────────────────────────────────────────────────────
# Coder Agent — Web Tools
# ────────────────────────────────────────────────────────────────────────────

# Max output size (chars) for web_fetch / web_search results. Default: 15000
# CODER_WEB_OUTPUT_CAP=15000

# Fetch timeout for web tools (ms). Default: 20000 (20s)
# CODER_WEB_TIMEOUT_MS=20000

# In-memory cache TTL for web tool results (ms). Default: 900000 (15 min)
# CODER_WEB_CACHE_TTL_MS=900000


# ────────────────────────────────────────────────────────────────────────────
# Coder Agent — Development / Debug
# ────────────────────────────────────────────────────────────────────────────

# Set "1" to watch system prompt .txt files for changes and hot-reload them.
# Only useful during development. Requires starting a new session to pick up. Default: 0
# CODER_PROMPTS_WATCH=0


# ────────────────────────────────────────────────────────────────────────────
# ChatGPT / OpenAI OAuth (advanced, rarely needed)
# ────────────────────────────────────────────────────────────────────────────
# Used for the ChatGPT Codex PKCE OAuth flow. Defaults are from the public
# Codex CLI app — only override if you have a custom OpenAI OAuth app.

# OpenAI OAuth client ID. Default: app_EMoamEEZ73f0CkXaXp7hrann
# OPENAI_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# ChatGPT Codex API base URL. Default: https://chatgpt.com/backend-api/codex
# CHATGPT_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex


# ────────────────────────────────────────────────────────────────────────────
# Kimi Code OAuth (advanced, rarely needed)
# ────────────────────────────────────────────────────────────────────────────
# Used by the Kimi Code provider in the Admin UI. Defaults mirror kimi-cli:
# device-code OAuth against auth.kimi.com and inference against coding/v1.

# Kimi Code OAuth client ID. Default: 17e5f671-d194-4dfb-9706-5516cb48c098
# KIMI_CODE_CLIENT_ID=17e5f671-d194-4dfb-9706-5516cb48c098

# Kimi Code API base URL. Default: https://api.kimi.com/coding/v1
# KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1

# Kimi Code OAuth host. Default: https://auth.kimi.com
# KIMI_CODE_OAUTH_HOST=https://auth.kimi.com

# Kimi Code client fingerprint version. Default mirrors kimi-cli 1.36.0.
# KIMI_CODE_CLIENT_VERSION=1.36.0

# Max completion tokens sent to /chat/completions. Default: 32000
# KIMI_CODE_MAX_TOKENS=32000


# ────────────────────────────────────────────────────────────────────────────
# ZAI URL Override (advanced)
# ────────────────────────────────────────────────────────────────────────────
# Override the ZAI API base URL. By default, coding models (glm-5.1, etc.)
# use https://api.z.ai/api/coding/paas/v4/ and general models use
# https://api.z.ai/api/paas/v4/. Set this to force a specific endpoint.
# ZAI_BASE_URL=


# ============================================================================
# Candidate-Pipeline Framework (PR3-PR12)
# ============================================================================
# All pipelines below are OPT-IN. Defaults preserve existing behavior so
# turning them on is non-disruptive — admin tabs (Pipelines / Pipeline
# Telemetry / Quality / Hot State) reflect activations immediately.
#
# Sample rates and feature flags are typically set at the SESSION level via
# `config_json.pipelines.*` in `company_sessions`; the env vars here are
# the FALLBACK when no per-session override exists.


# ────────────────────────────────────────────────────────────────────────────
# LSH — Locality-Sensitive Hashing for embeddings (PR7)
# ────────────────────────────────────────────────────────────────────────────

# When "1", the indexer populates embedding_simhash_signatures +
# embedding_lsh_buckets alongside every vector-store upsert. Enables
# 5-10× faster narrow-then-rerank search in hybrid.ts. Default: "0"
# MCP_LSH_INDEXING=0

# Embedding dimension for LSH hyperplanes. Match your embedding model:
#   bge-base / bge-m3 / Workers AI default → 768
#   text-embedding-3-small (OpenAI)        → 1536
#   text-embedding-3-large (OpenAI)        → 3072
# Smaller vectors are zero-padded; larger are truncated to this dim.
# Default: 768
# MCP_LSH_DIM=768


# ────────────────────────────────────────────────────────────────────────────
# Shadow Traffic (PR11)
# ────────────────────────────────────────────────────────────────────────────

# Fraction of tool-selection requests to ALSO run as shadow variants
# (k=8 and k=16 alongside production k=12). Logs predictions to
# counterfactual_logs. Sampling is deterministic per query_hash so the
# same task always falls in (or out of) shadow — bias-free analytics.
# Range: 0.0..1.0. Default: 0 (off)
# MCP_SHADOW_TOOL_SELECTION_RATE=0.05


# ────────────────────────────────────────────────────────────────────────────
# Pipeline Feature Flags (PR3-PR10)
# ────────────────────────────────────────────────────────────────────────────
# Each pipeline reads `config_json.pipelines.<flag>` per session first;
# falls back to the env var below; falls back to false. Operators can
# flip any of these per-session without redeploy.

# Tool-selection filter: filters tools by relevance before the provider
# call. Saves ~75% of system-prompt tokens in long sessions. Default: 0
# MCP_PIPELINES_TOOL_SELECTION=1
# Optional: 0 keeps the selector in shadow-only mode; default applies it.
# MCP_PIPELINES_TOOL_SELECTION_APPLY=0
# MCP_PIPELINES_TOOL_SELECTION_K=32

# Context-relevance compaction: drops messages by relevance, not by
# chronology. Preserves decision markers; protects last N turns.
# Recommended for sessions > 200 turns. Default: 0
# MCP_PIPELINES_CONTEXT_RELEVANCE=1

# TodoWrite priority reorder by impact × urgency × dependencies. Default: 0
# MCP_PIPELINES_TODO_PRIORITY=1

# Sub-agent result cache (Explore / Plan / general-purpose).
# TTLs: Explore=30m, Plan=5m, general-purpose=15m. Default: 0
# MCP_PIPELINES_SUB_AGENT_CACHE=1

# Quality classifiers (off_topic / completeness / code / policy /
# tool_misuse). Provider+model per classifier configured via the Admin
# → Pipelines tab. Costs LLM calls per agent turn — leave off until you
# have provider bindings set up. Default: 0
# MCP_PIPELINES_QUALITY_CLASSIFIERS=0


# ────────────────────────────────────────────────────────────────────────────
# Telemetry / Observability (PR1 + PR12)
# ────────────────────────────────────────────────────────────────────────────

# Sample rate for pipeline_telemetry trace_sampled rows. 0..1.
# 0 = only deterministic IDs in MCP_PIPELINE_TRACE_SESSION_IDS get full
# traces; 1 = trace everything (verbose, dev only). Default: 0.1
# MCP_PIPELINE_TRACE_SAMPLE_RATE=0.1

# Comma-separated session IDs that ALWAYS produce full traces. Useful
# for reproducing a specific user issue.
# MCP_PIPELINE_TRACE_SESSION_IDS=42,1337


# ────────────────────────────────────────────────────────────────────────────
# Drift Detection (PR12)
# ────────────────────────────────────────────────────────────────────────────
# Tunes the /api/admin/drift endpoint. The detector compares the last N
# hours against the prior baseline window using PSI over verdict bins.

# Recent window in hours. Default: 24
# MCP_DRIFT_RECENT_HOURS=24

# Baseline window in hours, ending at the start of the recent window.
# Default: 168 (7 days)
# MCP_DRIFT_BASELINE_HOURS=168

# Minimum rows in each window before drift is meaningful. Default: 30
# MCP_DRIFT_MIN_ROWS=30
