{
  "appId": "studio.codestudio.local",
  "productName": "CodeStudio Local",
  "extraMetadata": { "name": "codestudio-local" },
  "npmRebuild": false,
  "directories": {
    "output": "dist/electron-builder",
    "buildResources": "apps/electron/build"
  },
  "files": [
    "dist/apps/electron/**/*",
    "dist/apps/cli/**/*",
    "dist/apps/http-api/**/*",
    "dist/apps/mcp-server/**/*",
    "dist/dashboard/**/*",
    "dist/packages/**/*",
    "package.json",
    "!dist/apps/electron/native-agent-runtime-integrity.json",
    "!dist/apps/electron/src/cloud/**/*",
    "!dist/apps/http-api/server/github-app-managed-git/**/*",
    "!**/*.map"
  ],
  "asar": true,
  "electronFuses": {
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "asarUnpack": [
    "node_modules/@microsoft/copilot-sdk-*/**/*",
    "node_modules/koffi/**/*",
    "node_modules/better-sqlite3/**/*",
    "node_modules/node-pty/**/*",
    "node_modules/sqlite-vec/**/*",
    "node_modules/sqlite-vec-*/**/*",
    "node_modules/@huggingface/**/*",
    "node_modules/onnxruntime-node/**/*",
    "node_modules/onnxruntime-web/**/*",
    "node_modules/sharp/**/*",
    "node_modules/@img/**/*",
    "node_modules/ffmpeg-static/**/*",
    "node_modules/@jitl/**/*",
    "node_modules/quickjs-emscripten*/**/*"
  ],
  "extraResources": [
    {
      "from": "apps/electron/build/icon.png",
      "to": "icon.png"
    },
    {
      "from": "apps/http-api/vendor/drawio",
      "to": "drawio"
    },
    {
      "from": "dist/bundled-plugins",
      "to": "bundled-plugins"
    },
    {
      "from": "assets/semantic-models",
      "to": "semantic-models",
      "filter": ["**/*", "!.gitattributes"]
    },
    {
      "from": "node_modules/typescript/lib",
      "to": "ts-lib",
      "filter": [
        "**/*.d.ts"
      ]
    }
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "apps/electron/build/icon.ico"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "icon": "apps/electron/build/icon.icns",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "O CodeStudio usa o microfone para ditado de voz no compositor de mensagens."
    }
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "apps/electron/build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "include": "apps/electron/build/installer.nsh"
  },
  "publish": null,
  "extraFiles": [
    {
      "from": "apps/electron/build/codestudio-local.cmd",
      "to": "codestudio-local.cmd"
    }
  ]
}
