# Generated by dev.ts (and scripts/build-electron.mjs in prod).
# preload.cjs is a CJS bundle of preload.ts — Electron's preload loader
# would otherwise treat the root package.json's "type": "module" as ESM
# and silently fail to expose contextBridge. .cjs forces CommonJS
# resolution regardless of the type field.
