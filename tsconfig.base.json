{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@mcp/shared": ["packages/shared/src/index.ts"],
      "@mcp/shared/*": ["packages/shared/src/*"],
      "@mcp/store": ["packages/store/src/index.ts"],
      "@mcp/store/*": ["packages/store/src/*"],
      "@mcp/services": ["packages/services/src/index.ts"],
      "@mcp/services/*": ["packages/services/src/*"],
      "@mcp/indexer": ["packages/indexer/src/index.ts"],
      "@mcp/indexer/*": ["packages/indexer/src/*"],
      "@mcp/design-system": ["packages/design-system/src/index.ts"],
      "@mcp/design-system/*": ["packages/design-system/src/*"],
      "@mcp/code-agent": ["packages/code-agent/src/index.ts"],
      "@mcp/code-agent/*": ["packages/code-agent/src/*"],
      "@mcp/docs-agent": ["packages/docs-agent/src/index.ts"],
      "@mcp/docs-agent/*": ["packages/docs-agent/src/*"],
      "@mcp/company": ["packages/company/src/index.ts"],
      "@mcp/company/*": ["packages/company/src/*"],
      "@mcp/company-contracts": ["packages/company-contracts/src/index.ts"],
      "@mcp/company-contracts/*": ["packages/company-contracts/src/*"],
      "@mcp/candidate-pipeline": ["packages/candidate-pipeline/src/index.ts"],
      "@mcp/candidate-pipeline/*": ["packages/candidate-pipeline/src/*"],
      "@mcp/orchestrator-host": ["packages/orchestrator-host/src/index.ts"],
      "@mcp/orchestrator-host/*": ["packages/orchestrator-host/src/*"],
      "@mcp/api-bus": ["packages/api-bus/src/index.ts"],
      "@mcp/api-bus/*": ["packages/api-bus/src/*"],
      "@mcp/api-handlers": ["packages/api-handlers/src/index.ts"],
      "@mcp/api-handlers/*": ["packages/api-handlers/src/*"],
      "@mcp/worker-pool": ["packages/worker-pool/src/index.ts"],
      "@mcp/worker-pool/*": ["packages/worker-pool/src/*"],
      "@mcp/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@mcp/plugin-sdk/*": ["packages/plugin-sdk/src/*"],
      "@mcp/plugin-host": ["packages/plugin-host/src/index.ts"],
      "@mcp/plugin-host/*": ["packages/plugin-host/src/*"],
      "@apps/*": ["apps/*"]
    }
  }
}
