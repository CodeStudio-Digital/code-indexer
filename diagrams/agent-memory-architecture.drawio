<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="codestudio">
  <diagram name="Agent Memory Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="CodeStudio Agent Memory — dedicated agent_memory store (migration 181)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="16" width="980" height="34" as="geometry"/></mxCell>
        <mxCell id="legend" value="green = read/recall · orange = write · purple = maintenance · red = safety gate · gray = stores · blue = layers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="58" width="1380" height="34" as="geometry"/></mxCell>

        <!-- Three layers -->
        <mxCell id="layersGrp" value="Three distinct layers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="340" height="250" as="geometry"/></mxCell>
        <mxCell id="L1" value="Session notes (save_note / list_notes)&#10;scratchpad for ONE session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="layersGrp"><mxGeometry x="20" y="40" width="300" height="55" as="geometry"/></mxCell>
        <mxCell id="L2" value="AGENT MEMORY (remember / recall_memory / forget_memory)&#10;durable, single-fact, cross-session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="layersGrp"><mxGeometry x="20" y="105" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="L3" value="Snapshots (add_snapshot / get_snapshot)&#10;curated/indexed context — NOT routine memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="layersGrp"><mxGeometry x="20" y="175" width="300" height="55" as="geometry"/></mxCell>

        <!-- Read path -->
        <mxCell id="readGrp" value="Read / recall (per turn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="430" y="120" width="520" height="430" as="geometry"/></mxCell>
        <mxCell id="user" value="User turn" style="shape=umlActor;verticalLabelPosition=bottom;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="readGrp"><mxGeometry x="30" y="40" width="40" height="70" as="geometry"/></mxCell>
        <mxCell id="ignore" value="ignore memory?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="readGrp"><mxGeometry x="120" y="40" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="retrieve" value="retrieve relevant memory&#10;(turn 1 + task change)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="readGrp"><mxGeometry x="290" y="40" width="200" height="55" as="geometry"/></mxCell>
        <mxCell id="hybrid" value="hybrid search&#10;FTS5 + vector RRF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="readGrp"><mxGeometry x="290" y="120" width="200" height="55" as="geometry"/></mxCell>
        <mxCell id="score" value="re-score&#10;relevance x importance x recency x staleness; minRelevance floor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="readGrp"><mxGeometry x="290" y="195" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="selector" value="conservative selector (LLM, default-on)&#10;keep <=5, 'if unsure drop it'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="readGrp"><mxGeometry x="30" y="195" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="inject" value="inject as &lt;system-reminder&gt;&#10;background context, not instructions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="readGrp"><mxGeometry x="30" y="290" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="index" value="titles-only index&#10;turn 1 / post-compaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="readGrp"><mxGeometry x="290" y="290" width="200" height="55" as="geometry"/></mxCell>
        <mxCell id="agent" value="Main agent turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="readGrp"><mxGeometry x="120" y="370" width="260" height="40" as="geometry"/></mxCell>

        <!-- Write path -->
        <mxCell id="writeGrp" value="Write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="990" y="120" width="330" height="430" as="geometry"/></mxCell>
        <mxCell id="w1" value="remember (agent, as it learns)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="writeGrp"><mxGeometry x="20" y="40" width="290" height="40" as="geometry"/></mxCell>
        <mxCell id="w2" value="run-end distill + idle sweeper&#10;decisions / gotchas / procedures / promoted notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="writeGrp"><mxGeometry x="20" y="95" width="290" height="55" as="geometry"/></mxCell>
        <mxCell id="dedupe" value="central dedupe&#10;merge / supersede (archive + create, txn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="writeGrp"><mxGeometry x="20" y="165" width="290" height="55" as="geometry"/></mxCell>
        <mxCell id="embed" value="embed-on-write&#10;hash(content + model fingerprint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="writeGrp"><mxGeometry x="20" y="235" width="290" height="55" as="geometry"/></mxCell>
        <mxCell id="forget" value="forget_memory&#10;logical archive (reversible)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="writeGrp"><mxGeometry x="20" y="305" width="290" height="50" as="geometry"/></mxCell>
        <mxCell id="sync" value="sync (per-row intent) — gated by paid entitlement&#10;free = local-only; scope 'local' never syncs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="writeGrp"><mxGeometry x="20" y="365" width="290" height="50" as="geometry"/></mxCell>

        <!-- Stores -->
        <mxCell id="storesGrp" value="Stores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;verticalAlign=top;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="430" y="590" width="890" height="180" as="geometry"/></mxCell>
        <mxCell id="amTable" value="agent_memory (+ agent_memory_fts + vectors)&#10;scope/project_id/name/type/content/importance/referenced_files/&#10;embedding_hash/vector_id/sync/archived_at/superseded_by_id" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666;" vertex="1" parent="storesGrp"><mxGeometry x="40" y="40" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="evTable" value="agent_memory_events&#10;remember / recall / forget (pruned by sweeper)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666;" vertex="1" parent="storesGrp"><mxGeometry x="440" y="55" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="snapTable" value="snapshots (untouched)&#10;curated/index context" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666;" vertex="1" parent="storesGrp"><mxGeometry x="670" y="55" width="180" height="90" as="geometry"/></mxCell>

        <!-- Maintenance -->
        <mxCell id="maintGrp" value="Maintenance (idle sweeper) + Migration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="340" height="200" as="geometry"/></mxCell>
        <mxCell id="m1" value="collapse exact-duplicate memories&#10;(logical archive, keep best)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="maintGrp"><mxGeometry x="20" y="35" width="300" height="45" as="geometry"/></mxCell>
        <mxCell id="m2" value="prune agent_memory_events (retention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="maintGrp"><mxGeometry x="20" y="90" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="m3" value="snapshots -> agent_memory migration (one-way, non-destructive, idempotent)&#10;+ boot embedding backfill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="maintGrp"><mxGeometry x="20" y="140" width="300" height="50" as="geometry"/></mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="user" target="ignore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ignore" target="retrieve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2b" value="yes: skip" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="ignore" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="retrieve" target="hybrid"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="hybrid" target="score"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="score" target="selector"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="selector" target="inject"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="inject" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="index" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="read" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="hybrid" target="amTable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="learned" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="agent" target="w1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="w1" target="dedupe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="w2" target="dedupe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="dedupe" target="embed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="write" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="embed" target="amTable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="archive" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="forget" target="amTable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="sync" target="amTable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="dedup/prune" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="maintGrp" target="amTable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="one-way" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="snapTable" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
