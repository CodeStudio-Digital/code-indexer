/apps/dashboard/features/app-studio/data/TableCard.tsx
.tmp/
.reference/

# Secrets / keys — never commit private keys (PEM, pkcs8, etc.)
*.pem

# Vendored draw.io webapp — fetched via `pnpm drawio:fetch`, not committed
